# ------------------------------------------------------------------
# Public configuration (safe to expose to the browser)
# Copy this file to `.env.local` and adjust the values.
# ------------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME="HerbsKyoor Ayurveda"
NEXT_PUBLIC_SITE_URL="https://herbskyoor.example.com"

# Contact
NEXT_PUBLIC_CONTACT_EMAIL="care@herbskyoor.in"
# One or more numbers, separated by commas (each gets its own call link).
NEXT_PUBLIC_CONTACT_PHONE="+91 8750505094, +91 9654555236"
NEXT_PUBLIC_SHOP_ADDRESS="Kh 599 St No. 8 New Karhera Mohan Nagar Ghaziabad, Uttar Pradesh 201007"

# WhatsApp number in international format WITHOUT '+' or spaces (e.g. 919876543210)
# Orders are placed through WhatsApp / phone — no online payment gateway.
NEXT_PUBLIC_WHATSAPP_NUMBER="+91 8750505094"

# ------------------------------------------------------------------
# Admin panel (/admin) — SERVER ONLY, never exposed to the browser.
# Static credentials that gate catalogue editing.
# IMPORTANT: do NOT prefix these with NEXT_PUBLIC_ (that would ship the
# password to the browser). Login is disabled if either is unset.
# ------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# ------------------------------------------------------------------
# Production storage (Vercel Blob) — SERVER ONLY.
# On serverless the filesystem is read-only, so BOTH the catalogue JSON
# (ProductDetails/Product_list.json) and admin-uploaded images are
# persisted to Vercel Blob instead of the local filesystem.
#
# Create a Blob store in the Vercel dashboard (Storage → Create → Blob) and
# connect it to the project — the token below is then injected automatically
# into the deployment, so you normally do NOT set it by hand in production.
#
# For LOCAL admin testing against Blob (and to run the migration script),
# copy the token from the Vercel dashboard into .env.local. When it is
# absent, dev falls back to the local JSON file + public/ image folder.
# NOTE: never prefix this with NEXT_PUBLIC_ — it must stay server-side only.
# ------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"
