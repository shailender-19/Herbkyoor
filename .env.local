# ------------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME="HerbKyoor Ayurveda"
NEXT_PUBLIC_SITE_URL="https://herbkyoor.example.com"

# Contact
NEXT_PUBLIC_CONTACT_EMAIL="care@herbkyoor.in"
# One or more numbers, separated by commas (each gets its own call link).
NEXT_PUBLIC_CONTACT_PHONE="+91 8750505094, +91 9654555236"
NEXT_PUBLIC_SHOP_ADDRESS="Kh 599 St No. 8 New Karhera Mohan Nagar Ghaziabad, U.P. 201007"

# WhatsApp number in international format WITHOUT '+' or spaces (e.g. 919876543210)
# Orders are placed through WhatsApp / phone — no online payment gateway.
NEXT_PUBLIC_WHATSAPP_NUMBER="+91 8750505094"

# ------------------------------------------------------------------
# Admin panel (/admin) — SERVER ONLY, never exposed to the browser.
# Credentials that gate catalogue editing. Change these before going live.
# ------------------------------------------------------------------
