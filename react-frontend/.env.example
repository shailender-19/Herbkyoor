# =============================================================================
# HerbKyoor React + Vite frontend — PUBLIC configuration only.
# Copy to `.env` and adjust. Never put secrets, DB passwords or API keys here:
# every VITE_* value is inlined into the client bundle and is publicly visible.
# =============================================================================

# Base URL of the PHP API. In production the SPA and PHP share one domain, so
# "/api" is correct. Change only if the API lives on another host/path.
VITE_API_URL=/api

# Catalogue data source for the PUBLIC storefront:
#   true  -> read the bundled Product_list.json snapshot (works with NO backend)
#   false -> fetch live data from the PHP API (VITE_API_URL)
# Admin CRUD and the contact/newsletter forms ALWAYS use the PHP API.
VITE_USE_STATIC_DATA=true

# --- Public site config (former NEXT_PUBLIC_* variables) ---------------------
VITE_SITE_NAME=HerbKyoor Ayurveda
VITE_SITE_URL=https://herbkyoor.example.com
VITE_CONTACT_EMAIL=care@herbkyoor.in
# One or more numbers, comma separated: "+91 8750505094, +91 9654555236"
VITE_CONTACT_PHONE=+91 98765 43210
VITE_SHOP_ADDRESS=12, Herbal Lane, Green Park, New Delhi, India 110016
# International format WITHOUT '+', spaces or dashes, e.g. 919876543210
VITE_WHATSAPP_NUMBER=919876543210
