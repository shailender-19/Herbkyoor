# ============================================================
# HerbsKyoor backend configuration — copy to ".env" and fill in.
#   cp .env.example .env
# ".env" is git-ignored and must NEVER be web-accessible.
# Real OS environment variables override anything set here.
# ============================================================

# ---- Database ----
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_strong_db_password
DB_CHARSET=utf8mb4

# ---- Application ----
# 'production' or 'development' (controls server-side log verbosity only;
# client responses never leak details either way).
APP_ENV=production

# Force secure (HTTPS-only) session cookies. Even when false, the app
# auto-enables secure cookies whenever the request is served over HTTPS.
COOKIE_SECURE=true

# Upload settings (defaults are usually fine).
# UPLOAD_DIR=
# UPLOAD_URL_BASE=uploads/products
# MAX_UPLOAD_BYTES=5242880
# SESSION_LIFETIME=28800
