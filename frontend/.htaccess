# ------------------------------------------------------------------
# HerbKyoor Ayurveda — Apache config for standard shared hosting.
# The public site is fully static (HTML/CSS/JS). Upload the whole
# frontend/ directory contents to your web root via FTP.
# ------------------------------------------------------------------

# Default document
DirectoryIndex index.html

# Custom 404 page
ErrorDocument 404 /404.html

# Sensible caching for static assets (tune as needed)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
